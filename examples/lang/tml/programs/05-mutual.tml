(* 05 — mutual recursion and deep recursion
 *
 * Top-level functions see each other regardless of declaration
 * order, which is what mutual recursion needs. The typechecker
 * pre-binds every fun with a shared type variable, so even and odd
 * constrain each other to int -> bool.
 *)

fun even n = if n = 0 then true else odd (n - 1)

fun odd n = if n = 0 then false else even (n - 1)

val isTenEven = even 10

(* The Ackermann function: famous for growing faster than any
 * primitive recursion, yet still terminating on every input. *)
fun ack m n =
  if m = 0 then n + 1
  else if n = 0 then ack (m - 1) 1
  else ack (m - 1) (ack m (n - 1))

val ack33 = ack 3 3
